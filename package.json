{
  "name": "developer-portfolio-app",
  "version": "2.0.0",
  "description": "VS Code/Atom One Dark inspired developer portfolio app.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Prasoon-Upadhyay/prasoon-upadhyay"
  },
  "homepage": "https://turali.js.org",
  "license": "GNU GPLv3",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:base": "vitest run --passWithNoTests",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:update": "vitest run --passWithNoTests --update",
    "lint": "eslint \"*/**/*.{js,ts,tsx}\"",
    "lint:ci": "npm run lint -- --quiet",
    "lint:fix": "npm run lint -- --fix"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm test"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^1.2.36",
    "@fortawesome/free-brands-svg-icons": "^5.15.4",
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "@fortawesome/react-fontawesome": "^0.1.16",
    "clsx": "^1.1.1",
    "color": "^3.2.1",
    "dayjs": "^1.10.7",
    "isomorphic-unfetch": "^3.1.0",
    "normalize.css": "^8.0.1",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "react": "^18.3.1",
    "react-circular-progressbar": "^2.0.4",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-jss": "^10.8.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.1",
    "react-tooltip": "^4.2.21",
    "typed.js": "^2.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/color": "^3.0.2",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-helmet": "^5.0.19",
    "@typescript-eslint/eslint-plugin": "^2.34.0",
    "@typescript-eslint/parser": "^2.34.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "6.8.0",
    "eslint-config-prettier": "^6.15.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-react": "^7.26.1",
    "husky": "^4.3.8",
    "jsdom": "^24.1.3",
    "lint-staged": "^10.5.4",
    "prettier": "^2.4.1",
    "ts-node": "^9.1.1",
    "ts-node-dev": "^1.1.8",
    "typescript": "^5.9.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
